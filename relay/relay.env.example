# dsh-remote relay 环境配置（部署到服务器后放到 /opt/dsh-remote/relay.env，chmod 600）
# 插件侧用同一个 token：Mac 上放 $DSH_HOME/dsh-remote/relay-token（0600）

# 隧道共享密钥（必填）。可用 `node bin/dsh-remote.mjs gen-token` 生成
DSH_RELAY_TOKEN=change-me-to-a-long-random-token

# 监听地址/端口：只监听 loopback，由本机 nginx :3080 反代
DSH_RELAY_HOST=127.0.0.1
DSH_RELAY_PORT=3090

# LAN 探测周期（毫秒）与单次探测超时
DSH_RELAY_PROBE_MS=8000
DSH_RELAY_PROBE_TIMEOUT_MS=900
